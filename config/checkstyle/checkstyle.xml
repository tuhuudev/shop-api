<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Bo quy uoc code VUA PHAI cho shop-api. Tat ca o muc "warning" (chi canh bao,
  KHONG fail build - xem failOnViolation=false trong pom). Muc dich: nhac nho giu
  code sach, khong chan duong hoc.
-->
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="charset" value="UTF-8"/>

    <!-- Do dai dong toi da (noi long 160 cho thoai mai). -->
    <module name="LineLength">
        <property name="max" value="160"/>
        <property name="ignorePattern" value="^\s*//|^\s*\*|^import"/>
    </module>

    <module name="TreeWalker">
        <!-- Import sach -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <!-- KHONG bat AvoidStarImport: du an co y dung dang '.*' cho cac package annotation
             (jakarta.persistence.*, ...web.bind.annotation.*) de import gon. Day la quy uoc co san. -->

        <!-- Luon dung ngoac { } cho if/for/while... (tranh loi an) -->
        <module name="NeedBraces"/>

        <!-- Quy uoc dat ten -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>

        <!-- Khoang trang sau dau phay, can bang ngoac -->
        <module name="WhitespaceAfter"/>
        <module name="EmptyStatement"/>
    </module>
</module>
