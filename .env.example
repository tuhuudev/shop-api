# MAU bien moi truong cho shop-api. COPY thanh .env (hoac set bang setx) va dien gia tri that.
# KHONG commit file .env that len Git (xem .gitignore).

# Khoa bi mat ky JWT (base64, >= 32 byte). Bat buoc dat o production.
# Tao nhanh 1 chuoi base64 ngau nhien (PowerShell):
#   [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
APP_JWT_SECRET=

# (Tuy chon) origin frontend duoc phep goi API (cach nhau dau phay), vi du:
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# (Tuy chon) thong tin Postgres khi chay profile postgres
# SPRING_DATASOURCE_PASSWORD=shop123
