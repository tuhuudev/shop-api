# MAU bien moi truong cho shop-api. COPY thanh .env va dien gia tri that.
# KHONG commit .env that len Git (xem .gitignore).

# --- JWT RS256 (production): tro toi file khoa that (mount secret). Dev dung keys/*.pem trong classpath. ---
# APP_JWT_PRIVATE_KEY=file:/run/secrets/jwt-private.pem
# APP_JWT_PUBLIC_KEY=file:/run/secrets/jwt-public.pem

# --- Database (Postgres) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/shopdb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=shop123

# --- Redis ---
# SPRING_DATA_REDIS_HOST=redis
# SPRING_DATA_REDIS_PORT=6379

# --- CORS: origin frontend duoc phep (cach nhau dau phay) ---
# APP_CORS_ALLOWED_ORIGINS=https://shop.example.com

# --- Observability: OTLP collector cho tracing (vd Grafana Tempo / OTel Collector) ---
# MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
# TRACING_SAMPLING=0.1

# --- OWASP Dependency-Check (CI) NVD API key de quet nhanh ---
# NVD_API_KEY=
